# Codificação e indentação por tipo de arquivo (https://editorconfig.org).
# O VS Code aplica isto com a extensão EditorConfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

# O Windows PowerShell 5.1 lê .ps1 sem BOM como ANSI e quebra os acentos (CONTRATO.md, seção 1)
[*.ps1]
charset = utf-8-bom
indent_size = 4

[*.{lua,toc,xml,mjs,js,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Fixtures com bytes exatos (CRLF de propósito): o editor não mexe
[modder/ferramentas/testes/{fixture,fontes-fixture,respostas}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
